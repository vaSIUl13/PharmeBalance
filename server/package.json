{
  "name": "pharmabalance-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "forecast:run": "node --env-file-if-exists=.env dist/modules/forecasts/worker.js",
    "forecast:worker": "node --env-file-if-exists=.env dist/modules/forecasts/worker.js --watch",
    "test:forecasts": "npm run build && node --test test/forecasts.test.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed:demo": "prisma db execute --file prisma/demo.sql --schema prisma/schema.prisma",
    "db:seed:demo-users": "node --env-file-if-exists=.env prisma/seed-demo-users.cjs",
    "auth:enroll-admin": "node --env-file-if-exists=.env scripts/enroll-admin-mfa.cjs",
    "test:auth": "npm run build && node --test test/auth.integration.cjs",
    "test:imports": "npm run build && node --test test/import-file.test.cjs",
    "catalog:sync": "node --env-file-if-exists=.env scripts/catalog/sync.cjs",
    "catalog:link-sku": "node --env-file-if-exists=.env scripts/catalog/link-sku.cjs",
    "db:seed:demo-network": "node --env-file-if-exists=.env scripts/catalog/demo.cjs",
    "test:catalog": "node --test test/catalog.test.cjs",
    "test:catalog:integration": "npm run build && node --test test/catalog.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.6.1",
    "otplib": "^12.0.1",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.39.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.19.0",
    "typescript": "^5.9.0"
  }
}
