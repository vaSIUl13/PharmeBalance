{
  "name": "pharmabalance-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "forecast:run": "node --env-file-if-exists=.env dist/modules/forecasts/worker.js",
    "forecast:worker": "node --env-file-if-exists=.env dist/modules/forecasts/worker.js --watch",
    "demo:close-day": "node --env-file-if-exists=.env dist/cli/close-demo-day.js",
    "test:forecasts": "npm run build:test && node --test dist-test/test/unit/forecasts.test.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:demo": "node --env-file-if-exists=.env dist/cli/start-demo.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed:demo": "prisma db execute --file prisma/demo.sql --schema prisma",
    "db:seed:demo-users": "node --env-file-if-exists=.env dist/cli/seed-demo-users.js",
    "auth:enroll-admin": "node --env-file-if-exists=.env dist/cli/enroll-admin-mfa.js",
    "test:auth": "npm run build:test && node --test dist-test/test/auth.integration.js",
    "test:imports": "npm run build:test && node --test dist-test/test/unit/import-file.test.js",
    "catalog:sync": "node --env-file-if-exists=.env scripts/catalog/sync.cjs",
    "catalog:link-sku": "node --env-file-if-exists=.env scripts/catalog/link-sku.cjs",
    "db:seed:demo-network": "node --env-file-if-exists=.env scripts/catalog/demo.cjs",
    "db:enrich:demo-network": "node --env-file-if-exists=.env scripts/catalog/enrich-demo.cjs",
    "db:seed:workflow-users": "node --env-file-if-exists=.env dist/cli/seed-workflow-users.js",
    "routing:refresh": "node --env-file-if-exists=.env dist/cli/refresh-pharmacy-distances.js",
    "test:catalog": "npm run build:test && node --test dist-test/test/unit/catalog.test.js",
    "test:catalog:integration": "npm run build:test && node --test dist-test/test/catalog.integration.js",
    "test": "npm run test:unit",
    "test:unit": "npm run build:test && node --test dist-test/test/unit/*.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "test:forecast:isolation": "npm run build:test && node --test dist-test/test/forecast-isolation.integration.js",
    "test:forecast:demo": "npm run build:test && node --test dist-test/test/forecast-demo.integration.js",
    "test:workflow:demo": "npm run build:test && node --env-file-if-exists=.env --test dist-test/test/workflow-demo.integration.js",
    "auth:provision-superadmin": "node --env-file-if-exists=.env dist/cli/provision-superadmin.js",
    "preauth:enroll-admin": "npm run build",
    "predb:seed:demo-users": "npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.6.1",
    "otplib": "^12.0.1",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.39.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.19.0",
    "typescript": "^5.9.0"
  }
}
