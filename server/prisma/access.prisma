model Permission {
  permissionId Int @id @default(autoincrement()) @map("permission_id")
  code String @db.VarChar(30)
  name String @db.VarChar(100)
  requirement String? @db.VarChar(30)
  actionTypeRows ActionType[] @relation("fk_action_type_permission_id")
  rolePermissionRows RolePermission[] @relation("fk_role_permission_permission_id")

  @@unique([code], map: "permission_code_UNIQUE")
  @@map("permission")
}

model Role {
  roleId Int @id @default(autoincrement()) @map("role_id")
  code String @db.VarChar(20)
  name String @db.VarChar(60)
  dataScope DataScope @map("data_scope")
  description String? @db.VarChar(200)
  rolePermissionRows RolePermission[] @relation("fk_role_permission_role_id")
  userAccountRows UserAccount[] @relation("fk_user_account_role_id")

  @@unique([code], map: "role_code_UNIQUE")
  @@map("role")
}

model RolePermission {
  roleId Int @map("role_id")
  permissionId Int @map("permission_id")
  grantedAt DateTime @default(now()) @db.Timestamptz(3) @map("granted_at")
  permission Permission @relation("fk_role_permission_permission_id", fields: [permissionId], references: [permissionId], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permission_permission_id")
  role Role @relation("fk_role_permission_role_id", fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permission_role_id")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "fk_role_permission_permission_id_idx")
  @@map("role_permission")
}

model UserAccount {
  authSessions AuthSession[]
  authChallenges AuthChallenge[]
  authMfa AuthMfa?
  userId Int @id @default(autoincrement()) @map("user_id")
  login String @db.VarChar(50)
  passwordHash String @db.VarChar(255) @map("password_hash")
  lastName String @db.VarChar(60) @map("last_name")
  firstName String @db.VarChar(60) @map("first_name")
  email String @db.VarChar(100)
  roleId Int @map("role_id")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  role Role @relation("fk_user_account_role_id", fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_account_role_id")
  userPharmacyRows UserPharmacy[] @relation("fk_user_pharmacy_user_id")
  auditLogRowsTargetUser AuditLog[] @relation("fk_audit_log_target_user_id")
  auditLogRowsUser AuditLog[] @relation("fk_audit_log_user_id")
  recommendationActionRows RecommendationAction[] @relation("fk_recommendation_action_user_id")

  @@unique([login], map: "user_login_UNIQUE")
  @@unique([email], map: "user_email_UNIQUE")
  @@index([roleId], map: "fk_user_account_role_id_idx")
  @@map("user_account")
}

model UserPharmacy {
  userId Int @map("user_id")
  pharmacyId Int @map("pharmacy_id")
  assignedAt DateTime @default(now()) @db.Timestamptz(3) @map("assigned_at")
  unassignedAt DateTime? @db.Timestamptz(3) @map("unassigned_at")
  pharmacy Pharmacy @relation("fk_user_pharmacy_pharmacy_id", fields: [pharmacyId], references: [pharmacyId], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_pharmacy_pharmacy_id")
  user UserAccount @relation("fk_user_pharmacy_user_id", fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_pharmacy_user_id")
  importBatchRows ImportBatch[] @relation("fk_import_batch_uploaded_by_pharmacy_id")

  @@id([userId, pharmacyId])
  @@index([pharmacyId], map: "fk_user_pharmacy_pharmacy_id_idx")
  @@map("user_pharmacy")
}

model AuditLog {
  logId Int @id @default(autoincrement()) @map("log_id")
  userId Int @map("user_id")
  targetUserId Int? @map("target_user_id")
  stockId Int? @map("stock_id")
  eventType EventType @map("event_type")
  eventTime DateTime @default(now()) @db.Timestamptz(3) @map("event_time")
  details String? @db.VarChar(300)
  stock StockItem? @relation("fk_audit_log_stock_id", fields: [stockId], references: [stockId], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_log_stock_id")
  targetUser UserAccount? @relation("fk_audit_log_target_user_id", fields: [targetUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_log_target_user_id")
  user UserAccount @relation("fk_audit_log_user_id", fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_log_user_id")

  @@index([userId], map: "fk_audit_log_user_id_idx")
  @@index([targetUserId], map: "fk_audit_log_target_user_id_idx")
  @@index([stockId], map: "fk_audit_log_stock_id_idx")
  @@map("audit_log")
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  userId Int @map("user_id")
  user UserAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  mfaVerified Boolean @default(false) @map("mfa_verified")
  device String @db.VarChar(255)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_session")
}

model AuthChallenge {
  tokenHash String @id @map("token_hash") @db.Char(64)
  userId Int @map("user_id")
  user UserAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
  purpose String @db.VarChar(16)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_challenge")
}

model AuthMfa {
  userId Int @id @map("user_id")
  user UserAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
  encryptedSecret String @map("encrypted_secret")
  lastStep BigInt @default(-1) @map("last_step")
  recoveryHashes String[] @default([]) @map("recovery_hashes")

  @@map("auth_mfa")
}

model AuthAuditEvent {
  id BigInt @id @default(autoincrement())
  userId Int? @map("user_id")
  event String @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("auth_audit_event")
}
