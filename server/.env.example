PORT=3001
DATABASE_URL=postgresql://pharmabalance:replace-with-local-password@127.0.0.1:5432/pharmabalance?schema=public
AUTH_ORIGIN=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
AUTH_REDIS_PREFIX=pharme:auth

AUTH_MFA_KEY=
AUTH_SMTP_URL=
AUTH_MAIL_FROM=

# Existing MFA-enrolled admin account. Leave empty to disable public registration.
# Reviewer and applicant decision emails use these SMTP settings.
# Use a real SMTP relay and its authorized sender for delivery to Gmail.
REGISTRATION_REVIEWER_EMAIL=
AUTH_TRUSTED_PROXIES=

EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="PharmaBalance <notifications@pharmabalance.test>"
SMTP_USER=
SMTP_PASSWORD=

DRLZ_API_KEY=
CATALOG_USER_AGENT=
DEMO_DATABASE_URL=
TRANSFER_MAX_QUANTITY=100

# Decimal fractions for the real forecast worker. Example policy for local evaluation.
FORECAST_ABC_A=0.80
FORECAST_ABC_B=0.95
FORECAST_XYZ_X=0.10
FORECAST_XYZ_Y=0.25
